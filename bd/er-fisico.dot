digraph ER {
graph [rankdir=LR, splines=ortho, nodesep=0.5, ranksep=1.1, fontname="Liberation Sans", bgcolor="white", pad=0.4, label=<<B>Almi-Chain · modelo físico (PostgreSQL 16) · 17 tablas</B><BR/><FONT POINT-SIZE="11">PK clave primaria · FK clave externa · * NOT NULL · Azul: propias · Amarillo: espejo de Odoo · Verde: N:M · Rosa: ternaria · Generado desde el catálogo de la BD</FONT>>, labelloc=t, fontsize=18];
